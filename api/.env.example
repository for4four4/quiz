# Сервер
PORT=8080
JWT_SECRET=замените-на-длинную-случайную-строку
# Публичный адрес сайта (для ссылок, QR, SEO-канониклов и URL загруженных картинок)
PUBLIC_ORIGIN=https://qvalify.ru
# Куда сохранять загруженные картинки (варианты «с картинками», фото обложки)
UPLOAD_DIR=/var/www/quiz/uploads

# PostgreSQL
DATABASE_URL=postgres://kvalify:kvalify@localhost:5432/kvalify

# Polza.ai — OpenAI-совместимый агрегатор (https://polza.ai/docs)
POLZA_API_KEY=sk-...
POLZA_BASE_URL=https://polza.ai/api/v1
# Проверьте актуальные ID моделей на polza.ai/models (формат: провайдер/модель)
LLM_MODEL_FAST=anthropic/claude-haiku-4.5
LLM_MODEL_SMART=anthropic/claude-sonnet-4.6

# ── Сервер ──────────────────────────────────────────────
JWT_SECRET=замените-на-длинную-случайную-строку
# Публичный адрес сайта (ссылки, embed.js, CORS, SEO-каноникалы)
PUBLIC_ORIGIN=https://qvalify.ru
# Куда сохранять загруженные картинки
UPLOAD_DIR=/var/www/quiz/uploads

# ── PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgres://kvalify:kvalify@localhost:5432/kvalify

# ── Polza.ai — OpenAI-совместимый агрегатор нейросетей ───
# https://polza.ai/docs · доступ к моделям (ИИ-генерация квизов, обобщение лидов)
POLZA_API_KEY=sk-...
POLZA_BASE_URL=https://polza.ai/api/v1
# ID моделей — проверяйте на polza.ai/models (формат: провайдер/модель)
LLM_MODEL_FAST=anthropic/claude-haiku-4.5
LLM_MODEL_SMART=anthropic/claude-sonnet-4.6

# ── Интеграции (заполняются по мере подключения) ────────
TELEGRAM_BOT_TOKEN=
VK_TOKEN=
MAX_BOT_TOKEN=

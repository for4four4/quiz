# ─────────────────────────────────────────────────────────
#  Квалифай — переменные окружения
#  Скопируйте в .env:  cp .env.example .env  и заполните значения.
#  Файл .env в репозиторий не коммитится (см. .gitignore).
# ─────────────────────────────────────────────────────────

# ── Сервер ──────────────────────────────────────────────
JWT_SECRET=замените-на-длинную-случайную-строку
# Публичный адрес сайта (ссылки, embed.js, CORS, SEO-каноникалы).
# Для локального docker-запуска: http://localhost:3000
PUBLIC_ORIGIN=https://qvalify.ru
# Почты администраторов (через запятую) — доступ к /admin и /api/admin/*
ADMIN_EMAILS=you@example.ru
# Куда сохранять загруженные картинки (в docker монтируется как том)
UPLOAD_DIR=/var/www/quiz/uploads

# ── PostgreSQL ──────────────────────────────────────────
# ВНЕ docker — строка подключения к вашей БД:
DATABASE_URL=postgres://kvalify:kvalify@localhost:5432/kvalify
# В docker-compose БД поднимается сама, DATABASE_URL собирается
# из переменных ниже (менять не обязательно для локального запуска):
POSTGRES_USER=qvalify
POSTGRES_PASSWORD=qvalify
POSTGRES_DB=qvalify
# Порт, на котором сайт будет доступен на хосте (docker):
APP_PORT=3000

# ── Polza.ai — OpenAI-совместимый агрегатор нейросетей ───
# https://polza.ai/docs · доступ к моделям (ИИ-генерация квизов, обобщение лидов).
# Без ключа сайт работает, но ИИ-функции отключены.
POLZA_API_KEY=sk-...
POLZA_BASE_URL=https://polza.ai/api/v1
# ID моделей — проверяйте на polza.ai/models (формат: провайдер/модель)
LLM_MODEL_FAST=anthropic/claude-haiku-4.5
LLM_MODEL_SMART=anthropic/claude-sonnet-4.6

# ── SMTP — отправка заявок на почту ─────────────────────
# Нужно для канала «E-mail» (в редакторе квиза → «Куда слать заявки»).
# Без этих переменных остальные каналы работают, e-mail-доставка отключена.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# От кого приходит письмо (по умолчанию = SMTP_USER)
SMTP_FROM=

# ── Интеграции-мессенджеры (заполняются по мере подключения) ──
TELEGRAM_BOT_TOKEN=
VK_TOKEN=
MAX_BOT_TOKEN=
